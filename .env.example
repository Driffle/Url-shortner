# Copy to .env and inject via Deployer / your secret store.
# App lives in apps/web — paths below are for docker-compose at repo root.
#
# Driffle Deployer + Cloudflare: after deploy, set the public hostname in Deployer.
# Tunnel ingress targets http://127.0.0.1:<WEB_PUBLISH_PORT> (registered host port on the VM).

# --- Core URLs (example: shortly.driffle.net) ---
NEXTAUTH_URL=https://shortly.driffle.net
PUBLIC_APP_URL=https://shortly.driffle.net
WEB_PUBLISH_PORT=1004

# --- Auth ---
# Auth.js accepts NEXTAUTH_SECRET or AUTH_SECRET (32+ chars). Compose mirrors either into both.
NEXTAUTH_SECRET=replace-with-32plus-random-chars-minimum-please
# AUTH_SECRET=replace-with-32plus-random-chars-minimum-please

# No Google / open access: opt-in only (internal or staging). Leave commented in real deployments.
# NEXT_PUBLIC_PUBLIC_APP_NO_AUTH=true
# PUBLIC_APP_NO_AUTH=true

# With sign-in enabled, set real OAuth values and keep the two lines above commented out.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# When Google sign-in is on, add redirect URI: https://<your-host>/api/auth/callback/google

# --- Driffle access control (only used when Google sign-in is on) ---
ALLOWED_EMAIL_DOMAIN=driffle.com

# First deploy: optional explicit admin promotion on first login
BOOTSTRAP_ADMIN_EMAIL=

# --- Database / cache (Docker service names match compose) ---
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgresql://postgres:change-me-strong@db:5432/driffle_links?schema=public
REDIS_URL=redis://redis:6379
# Managed Redis ACL: key prefix your user may access (default `dl`). Example: app_driffle_url_shortner
# REDIS_KEY_PREFIX=app_driffle_url_shortner

# --- Product / redirects ---
# Host shown for short links (same FQDN as the app if everything is on one hostname)
SHORT_LINK_HOST=shortly.driffle.net
NEXT_PUBLIC_SHORT_LINK_HOST=shortly.driffle.net

# --- Ops hooks ---
CRON_SECRET=replace-for-scheduled-rollups
SLACK_WEBHOOK_URL=

# Optional click HMAC hardening between tiers (not required for single-app)
INTERNAL_CLICK_SECRET=
