# Copy to .env and inject via Deployer / your secret store.
# App lives in apps/web — paths below are for docker-compose at repo root.
#
# Driffle Deployer + Cloudflare: after deploy, set the public hostname in Deployer.
# Tunnel ingress targets http://127.0.0.1:<WEB_PUBLISH_PORT> (registered host port on the VM).

# --- Core URLs (example: shortly.driffle.net) ---
NEXTAUTH_URL=https://shortly.driffle.net
PUBLIC_APP_URL=https://shortly.driffle.net
# Auth.js v5 also reads AUTH_URL; if your host sets it, it must match NEXTAUTH_URL (same origin, no trailing slash).
# AUTH_URL=https://shortly.driffle.net
WEB_PUBLISH_PORT=1004

# --- Auth ---
# Auth.js accepts NEXTAUTH_SECRET or AUTH_SECRET (32+ chars). Compose mirrors either into both.
NEXTAUTH_SECRET=replace-with-32plus-random-chars-minimum-please
# AUTH_SECRET=replace-with-32plus-random-chars-minimum-please

# No Google / open access: opt-in only (internal or staging). Leave commented in real deployments.
# NEXT_PUBLIC_PUBLIC_APP_NO_AUTH=true
# PUBLIC_APP_NO_AUTH=true

# --- Sign-in (pick one mode) ---
#
# Recommended for Driffle production: Google Workspace (@driffle.com) via OAuth.
# 1) Create an OAuth 2.0 Web client in Google Cloud Console for your org.
# 2) Set both variables below to non-empty values (Deployer / secret store).
# 3) Authorized redirect URI must include exactly:
#    https://<same-host-as-NEXTAUTH_URL>/api/auth/google/callback
#    (Also register JavaScript origin: https://<same-host-as-NEXTAUTH_URL>)
# 4) Leave DISABLE_GOOGLE_AUTH unset (or empty). Only set DISABLE_GOOGLE_AUTH=1 if you must block Google
#    while client id/secret still exist in the environment (unusual).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# DISABLE_GOOGLE_AUTH=

# Password-only mode (no Google): leave GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET empty, then provision users with:
#   cd apps/web && npm run user:set-password -- you@driffle.com 'strong-password'
#
# --- Google OAuth: fix "Error 400: redirect_uri_mismatch" ---
# In Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0 Client ID:
# - Application type must be "Web application" (not Desktop).
# - Authorized redirect URIs → Add EXACTLY:
#     https://shortly.driffle.net/api/auth/google/callback
#   Use the same scheme + host as NEXTAUTH_URL (no trailing slash on the origin).
# - Authorized JavaScript origins → Add: https://shortly.driffle.net
# - If you see redirect_uri=https://localhost:3000/... in errors, NEXTAUTH_URL/AUTH_URL is wrong in prod.
# Save, wait ~1 minute, retry sign-in.

# --- Driffle access control (Google or credentials) ---
ALLOWED_EMAIL_DOMAIN=driffle.com

# Optional: promote this email to ADMIN on first successful Google login (first user is ADMIN anyway)
BOOTSTRAP_ADMIN_EMAIL=

# Seconds users must stay on /go/<slug> before a "visit" is counted (default 5).
# VISIT_HOLD_SECONDS=5

# --- Database / cache (Docker service names match compose) ---
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgresql://postgres:change-me-strong@db:5432/driffle_links?schema=public
REDIS_URL=redis://redis:6379
# Managed Redis ACL: key prefix your user may access (default `dl`). Example: app_driffle_url_shortner or app:driffle:shortner
# REDIS_KEY_PREFIX=app_driffle_url_shortner

# --- Product / redirects ---
# Host shown for short links (same FQDN as the app if everything is on one hostname)
SHORT_LINK_HOST=shortly.driffle.net
NEXT_PUBLIC_SHORT_LINK_HOST=shortly.driffle.net

# --- Ops hooks ---
CRON_SECRET=replace-for-scheduled-rollups
SLACK_WEBHOOK_URL=

# Optional click HMAC hardening between tiers (not required for single-app)
INTERNAL_CLICK_SECRET=
