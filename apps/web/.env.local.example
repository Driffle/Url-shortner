# Copy to apps/web/.env.local
# Start DB + Redis: docker compose -f ../docker-compose.local.yml up -d
#
# --- Skip Google login on localhost (npm run dev only) ---
# DISABLE_AUTH=true
# NEXT_PUBLIC_DISABLE_AUTH=true   # same value; shows hint in user menu

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/driffle_links?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-dev-dev-dev-dev-dev-dev-dev-dev-dev-dev-32"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

PUBLIC_APP_URL="http://localhost:3000"
SHORT_LINK_HOST="localhost:3000"
NEXT_PUBLIC_SHORT_LINK_HOST="localhost:3000"

ALLOWED_EMAIL_DOMAIN="driffle.com"

# Optional: promote this email to ADMIN on first login when other users exist
# BOOTSTRAP_ADMIN_EMAIL="you@driffle.com"
