# Copy to apps/web/.env.local
# Full guide: ../../docs/SETUP.md
#
# Start DB + Redis (repo root): docker compose -f docker-compose.local.yml up -d
#
# --- Skip Google on localhost (npm run dev only) ---
# DISABLE_AUTH=true
# NEXT_PUBLIC_DISABLE_AUTH=true

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/driffle_links?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

NEXTAUTH_URL="http://127.0.0.1:3000"
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters-ok"

# Real Google OAuth values, OR any non-empty placeholders if DISABLE_AUTH=true
GOOGLE_CLIENT_ID="replace-me.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-me"

PUBLIC_APP_URL="http://127.0.0.1:3000"
SHORT_LINK_HOST="127.0.0.1:3000"
NEXT_PUBLIC_SHORT_LINK_HOST="127.0.0.1:3000"

ALLOWED_EMAIL_DOMAIN="driffle.com"

# Optional: promote this email to ADMIN on first login when other users exist
# BOOTSTRAP_ADMIN_EMAIL="you@driffle.com"
